{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/tresor-hontonnou",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/profils-officiels",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/telegram-bots.html",
      "destination": "/#bots",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}