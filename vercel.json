{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/tresor-hontonnou",
      "destination": "/"
    },
    {
      "source": "/profils-officiels",
      "destination": "/"
    },
    {
      "source": "/projets/:path*",
      "destination": "/projets-nexus-2026.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
